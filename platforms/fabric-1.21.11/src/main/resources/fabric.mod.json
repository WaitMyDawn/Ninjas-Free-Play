{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["yagen.waitmydawn.ninjas_free_play.NinjasFreePlay"],
    "client": ["yagen.waitmydawn.ninjas_free_play.setup.ClientSetupEvents"]
  },
  "mixins": ["ninjas_free_play.movement.mixins.json", { "config": "ninjas_free_play.mixins.json", "environment": "client" }],
  "depends": {
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}"
  }
}
